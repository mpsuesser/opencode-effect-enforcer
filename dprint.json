{
  "indentWidth": 2,
  "useTabs": false,
  "lineWidth": 100,
  "newLineKind": "lf",
  "excludes": ["node_modules", "bun.lock", "skills", "guidance", "patterns"],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.95.15.wasm",
    "https://plugins.dprint.dev/json-0.21.3.wasm"
  ],
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "preferDouble",
    "trailingCommas": "never"
  }
}
