{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "opencode-effect-enforcer",
  "version": "0.1.0",
  "description": "OpenCode plugin that enforces Effect-first development patterns via real-time code smell detection, 39 Effect skills, and comprehensive reference docs.",
  "license": "MIT",
  "files": [
    "src",
    "patterns",
    "skills",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./plugin": {
      "import": "./src/plugin.ts"
    }
  },
  "scripts": {
    "build": "vp build",
    "check": "vp check --fix",
    "test": "vitest run",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.40.5",
    "@effect/platform-bun": "4.0.0-beta.43",
    "effect": "4.0.0-beta.43",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@effect/language-service": "^0.80.0",
    "@effect/vitest": "4.0.0-beta.43",
    "@opencode-ai/plugin": "^1.3.8",
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.3",
    "vite-plus": "^0.1.14",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "overrides": {
    "effect": "4.0.0-beta.43",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.14"
  },
  "packageManager": "bun@1.3.11"
}
